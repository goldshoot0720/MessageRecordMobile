<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 通知紀錄含個人內容，不隨雲端備份或換機轉移離開裝置。 -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
